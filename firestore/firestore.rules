rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && getRole() in ["lecturer", "admin"];
      allow write: if getRole() == "admin" || (request.auth.uid == uid &&
        request.resource.data.role == resource.data.role);
    }

    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if getRole() == "admin";
    }

    match /attendanceSessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if getRole() in ["lecturer", "admin"] &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if getRole() == "admin" ||
        (getRole() == "lecturer" && resource.data.createdBy == request.auth.uid);
      allow delete: if getRole() == "admin";
      // Split from a single `allow write` on purpose: the original blanket
      // rule let ANY lecturer open/close ANY OTHER lecturer's session, not
      // just their own — no error thrown, Firestore just silently allowed
      // it. `create` now requires the new doc's createdBy to match the
      // caller; `update` requires the EXISTING doc's createdBy to match
      // (admins bypass both, same as elsewhere in this file).
    }

    match /{path=**}/records/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        resource.data.studentUid == request.auth.uid ||
        getRole() in ["lecturer", "admin"]
      );
      allow write: if false;
      // ALL record writes go through /api/attendance/[sessionId]/identify
      // and the manual-override endpoint, using firebase-admin — never
      // direct client writes. The client must never be able to
      // unilaterally claim an identity match. See lib/attendance.ts.
      //
      // Using match /{path=**}/records/{uid} enables both:
      //  - Single-doc get() and subcollection queries by known path
      //  - collectionGroup("records") query on student's attendance-history page
    }
  }
}
