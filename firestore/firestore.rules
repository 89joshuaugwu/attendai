rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getRole() {
      return request.auth != null
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && getRole() in ["lecturer", "admin"];
      allow write: if getRole() == "admin" || (request.auth.uid == uid &&
        request.resource.data.role == resource.data.role);
    }

    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if getRole() == "admin";
    }

    match /attendanceSessions/{sessionId} {
      allow read: if request.auth != null;
      allow write: if getRole() in ["lecturer", "admin"];

      match /records/{uid} {
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          resource.data.studentUid == request.auth.uid ||
          getRole() in ["lecturer", "admin"]
        );
        allow write: if false;
        // ALL record writes go through /api/attendance/[sessionId]/identify
        // and the manual-override endpoint, using firebase-admin — never
        // direct client writes. The client must never be able to
        // unilaterally claim an identity match. See lib/attendance.ts.
        //
        // Two read conditions cover two different query shapes:
        //  - request.auth.uid == uid: single-doc get() by known path,
        //    e.g. AttendanceRecordsView reading a specific session's records.
        //  - resource.data.studentUid == request.auth.uid: needed for the
        //    collectionGroup("records") query on the student's own
        //    attendance-history page. Firestore validates `list` queries
        //    against the whole possible result set, not the docs actually
        //    returned — a rule based only on document ID can't be proven
        //    safe for an unfiltered collectionGroup query, so the query
        //    must filter with `where("studentUid", "==", uid)` AND the rule
        //    must reference that same field for Firestore to allow it.
      }
    }
  }
}
